      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "cfjcdjfdsip6oa"
          },
          "query": "from(bucket: \"sensors\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"camera_motion\")\n  |> filter(fn: (r) => r[\"_field\"] == \"timestamp\")\n  |> aggregateWindow(every: 1m, fn: count, createEmpty: true)\n  |> map(fn: (r) => ({ r with _value: if r._value > 0 then 1 else 0 }))\n  |> group(columns: [\"_measurement\"])",
          "refId": "A"
        }
      ],
      "title": "Room Motion Timeline",
      "type": "state-timeline"
    }
